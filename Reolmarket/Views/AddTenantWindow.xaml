<Window x:Class="Reolmarket.Views.AddTenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Tenant" Height="380" Width="365"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Add New Tenant" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Name:" Margin="0,0,0,5" FontWeight="Bold"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="35" BorderThickness="1" BorderBrush="#DDD"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Email:" Margin="0,0,0,5" FontWeight="Bold"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="35" BorderThickness="1" BorderBrush="#DDD"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Phone:" Margin="0,0,0,5" FontWeight="Bold"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="35" BorderThickness="1" BorderBrush="#DDD"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="40">
                <Button Content="OK" Command="{Binding OkCommand}" Width="80" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" Padding="5"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Background="#f44336" Foreground="White" Padding="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
