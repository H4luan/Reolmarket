<Window x:Class="Reolmarket.Views.SaleCorrectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ret vare på et salg"
        Height="620"
        Width="1120"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Gem rettelse" Click="SaveCorrection_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Genindlæs" Command="{Binding ReloadCommand}" Padding="14,7"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Vælg en salgslinje på listen. Du kan ændre pris, reol og note i felterne ved siden af."
                   TextWrapping="Wrap"
                   Foreground="#526174"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Lines}"
                      SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dato" Binding="{Binding SaleDate,StringFormat=dd-MM-yyyy}" Width="95"/>
                    <DataGridTextColumn Header="Salg" Binding="{Binding SaleId}" Width="55"/>
                    <DataGridTextColumn Header="Produkt" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Antal" Binding="{Binding Quantity}" Width="55"/>
                    <DataGridTextColumn Header="Pris/stk." Binding="{Binding SalePrice,StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Reol" Binding="{Binding ShelfNumber}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Padding="16" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ret valgt salgslinje" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <TextBlock Text="Produkt" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedLine.ProductName,TargetNullValue=Vælg en salgslinje}" Margin="0,4,0,12"/>

                        <TextBlock Text="Pris pr. stk. (kr.)" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SelectedLine.SalePrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SelectedLine}"
                                 Padding="7" Margin="0,4,0,12"/>

                        <TextBlock Text="Reolnummer" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Shelves}"
                                  DisplayMemberPath="ShelfNumber"
                                  SelectedValuePath="ShelfId"
                                  SelectedValue="{Binding SelectedLine.ShelfId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding SelectedLine}"
                                  Padding="6" Margin="0,4,0,12"/>

                        <TextBlock Text="Note" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SelectedLine.Comment,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SelectedLine}"
                                 MinHeight="90"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="7" Margin="0,4,0,14"/>

                        <Button Content="Gem ændringer" Click="SaveCorrection_Click" Padding="12,8" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
