<Window x:Class="Reolmarket.Views.SaleCorrectionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ret salgslinje" Height="520" Width="1000" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Button Content="Gem rettelse" Click="SaveCorrection_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Genindlæs" Command="{Binding ReloadCommand}" Padding="12,6"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,10,0,0"/>
  <DataGrid x:Name="CorrectionsGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Dato" Binding="{Binding SaleDate,StringFormat=dd-MM-yyyy}" IsReadOnly="True" Width="95"/><DataGridTextColumn Header="Salg" Binding="{Binding SaleId}" IsReadOnly="True" Width="60"/><DataGridTextColumn Header="Produkt" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Antal" Binding="{Binding Quantity}" IsReadOnly="True" Width="55"/><DataGridTextColumn Header="Pris/stk." Binding="{Binding SalePrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
    <DataGridTemplateColumn Header="Reol" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ShelfNumber}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Shelves,RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="ShelfNumber" SelectedValuePath="ShelfId" SelectedValue="{Binding ShelfId,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Note" Binding="{Binding Comment,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="170"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
