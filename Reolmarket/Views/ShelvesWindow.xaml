<Window x:Class="Reolmarket.Views.ShelvesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reolregister"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <Button Content="Ny reol"
                    Command="{Binding AddShelfCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0"/>

            <Button Content="Gem"
                    Command="{Binding SaveShelfCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0"/>

            <Button Content="Slet"
                    Command="{Binding DeleteShelfCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0"/>

            <Button Content="Genindlæs"
                    Command="{Binding ReloadShelvesCommand}"
                    Padding="12,6"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Shelves}"
                  SelectedItem="{Binding SelectedShelf, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,0,0,12">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Database-ID"
                                    Binding="{Binding ShelfId}"
                                    IsReadOnly="True"
                                    Width="120"/>

                <DataGridTextColumn Header="Reolnummer"
                                    Binding="{Binding ShelfNumber, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140"/>

                <DataGridTextColumn Header="Placering"
                                    Binding="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="Indretning:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Width="240"
                      ItemsSource="{Binding LayoutOptions}"
                      SelectedItem="{Binding SelectedShelf.Layout, Mode=TwoWay}"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="0,4,0,0"/>
    </Grid>
</Window>