<Window x:Class="Reolmarket.Views.RentalCancellationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opsig reol"
        Height="620"
        Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Opsig en lejet reol"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Opsigelse inden den 20. giver normalt slutdato ved udgangen af næste måned. Indgives opsigelsen den 20. eller senere, rykkes slutdatoen én måned. Lejeaftalen fortsætter til og med den valgte slutdato."
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="Opsigelsesdato" Margin="0,0,0,5"/>
                <DatePicker Width="180"
                            SelectedDate="{Binding RequestDate}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Sidste lejedag" Margin="0,0,0,5"/>
                <DatePicker Width="180"
                            SelectedDate="{Binding EndDate}"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Rentals}"
                  SelectedItem="{Binding SelectedRental, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lejer"
                                    Binding="{Binding Tenant.Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="Reol"
                                    Binding="{Binding Shelf.ShelfNumber}"
                                    Width="90"/>
                <DataGridTextColumn Header="Startdato"
                                    Binding="{Binding StartDate, StringFormat={}{0:dd-MM-yyyy}}"
                                    Width="130"/>
                <DataGridTextColumn Header="Nuværende slutdato"
                                    Binding="{Binding EndDate, StringFormat={}{0:dd-MM-yyyy}}"
                                    Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,8">
                <Button Content="Genindlæs"
                        Command="{Binding ReloadCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"/>
                <Button Content="Gem opsigelse"
                        Command="{Binding SaveCancellationCommand}"
                        Padding="12,6"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
