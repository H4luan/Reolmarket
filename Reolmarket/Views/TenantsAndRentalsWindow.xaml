<Window x:Class="Reolmarket.Views.TenantsAndRentalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lejere og lejeaftaler"
        Height="680"
        Width="1050"
        MinHeight="540"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#243447"/>
            <Setter Property="BorderBrush" Value="#D2D9E2"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D8DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,0,0,14">
            <TextBlock Text="Lejere og reolleje" FontSize="24" FontWeight="Bold" Foreground="#25364A"/>
            <TextBlock Text="Vælg en lejer for at se reoler, lejeperioder og gemte afregninger." FontSize="14" Foreground="#68778A" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Lejere" FontSize="17" FontWeight="SemiBold" Foreground="#25364A" Margin="2,0,0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EDF0F4" BorderThickness="0,0,0,1" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#68778A"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#68778A"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="2" Columns="2" Margin="-5,8,-5,-5">
                    <Button Content="Tilføj lejer" Command="{Binding AddTenantCommand}" Background="#2F9E65" Foreground="White" BorderBrush="#2F9E65"/>
                    <Button Content="Slet lejer" Command="{Binding DeleteTenantCommand}" Background="#D9534F" Foreground="White" BorderBrush="#D9534F"/>
                </UniformGrid>
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SelectedTenant.Name, TargetNullValue='Vælg en lejer'}" FontSize="20" FontWeight="Bold" Foreground="#25364A"/>
                        <TextBlock Text="{Binding SelectedTenant.Email}" FontSize="12" Foreground="#68778A"/>
                        <TextBlock Text="{Binding SelectedTenant.Phone}" FontSize="12" Foreground="#68778A"/>
                        <Border Background="#F3F5F8" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox Content="Brug særpris pr. reol"
                                          IsChecked="{Binding UseCustomRent, Mode=TwoWay}"
                                          IsEnabled="{Binding HasSelectedTenant}"/>
                                <TextBlock Text="Pris pr. reol pr. måned (kr.)" FontSize="12" Foreground="#68778A" Margin="0,6,0,3"/>
                                <DockPanel>
                                    <TextBox Text="{Binding CustomRentPerShelf, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding UseCustomRent}"
                                             Width="150"
                                             Padding="6"
                                             VerticalContentAlignment="Center"/>
                                    <Button Content="Gem særpris"
                                            Command="{Binding SaveCustomRentCommand}"
                                            IsEnabled="{Binding HasSelectedTenant}"
                                            Margin="8,0,0,0"
                                            MinHeight="32"
                                            Padding="10,4"/>
                                </DockPanel>
                                <TextBlock Text="Slå særprisen fra for at bruge standardprisen efter antal reoler."
                                           FontSize="11" Foreground="#68778A" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TabControl Grid.Row="1" BorderBrush="#D8DEE7">
                        <TabItem Header="Lejeaftaler">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Reoler og lejeperioder" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedTenantRentals}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EDF0F4" BorderThickness="0,0,0,1" Padding="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Shelf.ShelfNumber, StringFormat='Reol {0}'}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding MonthlyRent, StringFormat='Leje: {0:N0} kr./måned'}" FontSize="12" Foreground="#68778A"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding StartDate, StringFormat='Fra: {0:dd-MM-yyyy}'}" FontSize="12" Foreground="#68778A"/>
                                                        <TextBlock Text="{Binding EndDate, TargetNullValue='Ingen slutdato', StringFormat='Til: {0:dd-MM-yyyy}'}" FontSize="12" Foreground="#68778A"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Afregningshistorik">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Gemte månedsafregninger" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedTenantSettlements}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EDF0F4" BorderThickness="0,0,0,1" Padding="9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PeriodStart, StringFormat='Afregning: {0:MMMM yyyy}'}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding GrossSales, StringFormat='Salg: {0:N2} kr.'}" FontSize="12" Foreground="#68778A"/>
                                                    <TextBlock Text="{Binding TotalReturns, StringFormat='Returer: -{0:N2} kr.'}" FontSize="12" Foreground="#68778A"/>
                                                    <TextBlock Text="{Binding Commission, StringFormat='Provision: -{0:N2} kr.'}" FontSize="12" Foreground="#68778A"/>
                                                    <TextBlock Text="{Binding RentForNextPeriod, StringFormat='Leje: -{0:N2} kr.'}" FontSize="12" Foreground="#68778A"/>
                                                    <TextBlock Text="{Binding HistoryResultMessage}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2" Text="Afregningen viser et beløb til udbetaling eller opkrævning. Betaling registreres ikke i programmet." FontSize="12" Foreground="#68778A" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <Button Grid.Row="2" Content="Opret lejeaftale" Command="{Binding AddRentalCommand}" CommandParameter="{Binding SelectedTenant}" HorizontalAlignment="Right" Margin="0,10,0,0" Background="#2F80C9" Foreground="White" BorderBrush="#2F80C9"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#5D523C"/>
    </Grid>
</Window>


