<Window x:Class="Reolmarket.Views.AddRentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Opret lejeaftale"
        Height="680"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">

            <TextBlock Text="Opret lejeaftale"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Lejer:"
                           Margin="0,0,0,5"
                           FontWeight="Bold"/>

                <ComboBox ItemsSource="{Binding Tenants}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="TenantId"
                          SelectedValue="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                          Height="35"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Reol:"
                           Margin="0,0,0,5"
                           FontWeight="Bold"/>

                <ComboBox ItemsSource="{Binding Shelves}"
                          DisplayMemberPath="RentalSelectionDisplayName"
                          SelectedValuePath="ShelfId"
                          SelectedValue="{Binding ShelfId, UpdateSourceTrigger=PropertyChanged}"
                          Height="35"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Ledige naboreoler (valgfrit):"
               Margin="0,0,0,5"
               FontWeight="Bold"/>

                <ComboBox ItemsSource="{Binding NeighborShelves}"
              DisplayMemberPath="RentalSelectionDisplayName"
              SelectedItem="{Binding SelectedNeighborShelf}"
              Height="35"/>

                <TextBlock Text="{Binding NeighborMessage}"
               TextWrapping="Wrap"
               Margin="0,5,0,0"/>
            </StackPanel>


            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Startdato:"
                           Margin="0,0,0,5"
                           FontWeight="Bold"/>

                <TextBox Text="{Binding StartDate, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         Height="35"
                         BorderThickness="1"
                         BorderBrush="#DDD"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Slutdato (valgfri):"
                           Margin="0,0,0,5"
                           FontWeight="Bold"/>

                <TextBox Text="{Binding EndDate, StringFormat='yyyy-MM-dd', UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         Height="35"
                         BorderThickness="1"
                         BorderBrush="#DDD"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Betalingsform:" Margin="0,0,0,5" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedPaymentMethodOption}"
                          Height="35"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Månedlig leje:"
               Margin="0,0,0,5"
               FontWeight="Bold"/>

                <TextBlock Text="{Binding MonthlyRentText}"
               Height="35"
               VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Height="40">

                <Button Content="Gem"
                        Command="{Binding OkCommand}"
                        Width="80"
                        Margin="0,0,10,0"
                        Background="#2196F3"
                        Foreground="White"
                        Padding="5"/>

                <Button Content="Annuller"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Background="#f44336"
                        Foreground="White"
                        Padding="5"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
