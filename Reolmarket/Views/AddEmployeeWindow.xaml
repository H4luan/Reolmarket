<Window x:Class="Reolmarket.Views.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tilføj medarbejder"
        Height="400"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">

            <TextBlock Text="Ny medarbejder"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Navn:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     Height="35"
                     Margin="0,0,0,15"/>

            <TextBlock Text="E-mail:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     Height="35"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Telefon:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8"
                     Height="35"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Opret"
                        Command="{Binding OkCommand}"
                        Width="80"
                        Margin="0,0,10,0"
                        Padding="5"/>

                <Button Content="Annuller"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Padding="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
