<Window x:Class="Reolmarket.Views.SettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Månedsafregning" Height="740" Width="1050"
        MinHeight="620" MinWidth="850" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Månedsafregning" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Lejer" Margin="0,0,0,4"/>
                <ComboBox Width="250" ItemsSource="{Binding Tenants}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTenant}"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Måned" Margin="0,0,0,4"/>
                <DatePicker Width="150" SelectedDate="{Binding SelectedMonth}"/>
            </StackPanel>
            <Button Content="Beregn afregning" Command="{Binding CalculateCommand}" Padding="14,7" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
            <Button Content="Gem afregning" Command="{Binding SaveCommand}" Padding="14,7" VerticalAlignment="Bottom"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Afregningshistorik for valgt lejer" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding Settlements}" SelectedItem="{Binding SelectedSettlement}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Måned" Binding="{Binding PeriodStart,StringFormat=MM-yyyy}" Width="80"/>
                            <DataGridTextColumn Header="Resultat" Binding="{Binding HistoryResultMessage}" Width="*"/>
                            <DataGridTextColumn Header="Senest rettet" Binding="{Binding LastModifiedAt,StringFormat=dd-MM-yyyy HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="Medarbejder" Binding="{Binding ModifiedByEmployeeName}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Afregningens beløb" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Beregn beløbene, og ret felterne efter behov. Vælg en historisk afregning for at rette den." TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,12"/>

                        <TextBlock Text="Periode" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentSettlement.PeriodStart,StringFormat=MMMM yyyy,TargetNullValue=Ingen afregning valgt}" Margin="0,3,0,10"/>

                        <TextBlock Text="Salg før retur (kr.)" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CurrentSettlement.GrossSales,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" IsEnabled="{Binding HasCurrentSettlement}" Padding="6" Margin="0,3,0,8"/>

                        <TextBlock Text="Returer (kr.)" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CurrentSettlement.TotalReturns,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" IsEnabled="{Binding HasCurrentSettlement}" Padding="6" Margin="0,3,0,8"/>

                        <TextBlock Text="Provision (kr.)" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CurrentSettlement.Commission,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" IsEnabled="{Binding HasCurrentSettlement}" Padding="6" Margin="0,3,0,8"/>

                        <TextBlock Text="Leje for næste periode (kr.)" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CurrentSettlement.RentForNextPeriod,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" IsEnabled="{Binding HasCurrentSettlement}" Padding="6" Margin="0,3,0,8"/>

                        <TextBlock Text="Medarbejder, der retter" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedEmployee}" Padding="5" Margin="0,3,0,10"/>

                        <TextBlock Text="Beløb til afregning" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentSettlement.ResultMessage,TargetNullValue=Beregn eller vælg en afregning}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,8"/>
                        <TextBlock Text="{Binding CurrentSettlement.AuditMessage}" Foreground="#526174" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
