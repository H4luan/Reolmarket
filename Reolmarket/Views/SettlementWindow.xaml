<Window x:Class="Reolmarket.Views.SettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Månedsafregning"
        Height="590"
        Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Månedsafregning pr. lejer"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="Lejer" Margin="0,0,0,5"/>
                <ComboBox Width="260"
                          ItemsSource="{Binding Tenants}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTenant}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Måned" Margin="0,0,0,5"/>
                <DatePicker Width="170"
                            SelectedDate="{Binding SelectedMonth}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,14">
            <Button Content="Beregn"
                    Command="{Binding CalculateCommand}"
                    Padding="14,7"
                    Margin="0,0,8,0"/>
            <Button Content="Gem afregning"
                    Command="{Binding SaveCommand}"
                    Padding="14,7"/>
        </StackPanel>

        <Border Grid.Row="3"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Padding="16"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Afregningsgrundlag"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>
                <TextBlock Text="{Binding CurrentSettlement.PeriodStart, StringFormat='Periode: {0:dd-MM-yyyy}'}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentSettlement.GrossSales, StringFormat='Salg: {0:N2} kr.'}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentSettlement.TotalReturns, StringFormat='Returer: -{0:N2} kr.'}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentSettlement.NetSales, StringFormat='Salg efter returer: {0:N2} kr.'}"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentSettlement.Commission, StringFormat='Provision (10 %): -{0:N2} kr.'}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentSettlement.RentForNextPeriod, StringFormat='Næste måneds leje: -{0:N2} kr.'}"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding CurrentSettlement.ResultMessage}"
                           FontSize="16"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>